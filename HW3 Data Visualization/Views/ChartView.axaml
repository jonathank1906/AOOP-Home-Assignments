<UserControl
    x:Class="HW3_Data_Visualization.Views.ChartView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:HW3_Data_Visualization.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:ChartViewModelBase"
    mc:Ignorable="d">

    <DockPanel>
        <!--  Header with Title and Delete Button  -->
        <DockPanel Margin="10" DockPanel.Dock="Top">
            <TextBlock
                Margin="0,0,10,0"
                DockPanel.Dock="Left"
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <Button
                Padding="0"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding RemoveChartCommand}"
                CommandParameter="{Binding}"
                DockPanel.Dock="Right">
                <Image
                    Width="32"
                    Height="32"
                    Source="{SvgImage /Assets/trash-icon.svg}" />
            </Button>
        </DockPanel>

        <ContentControl>
    <ContentControl.Styles>
        <Style Selector="ContentControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeriesCollection}" Value="{x:Null}">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentControl.Styles>

    <ContentControl.Content>
        <lvc:CartesianChart
            x:Name="Cartesian"
            Background="#FFCB9A"
            CornerRadius="15"
            MinHeight="400"
            Series="{Binding SeriesCollection}"
            XAxes="{Binding XAxes}"
            YAxes="{Binding YAxes}"
            ZoomMode="Both" />

        <lvc:PieChart
            x:Name="Pie"
            Background="#FFCB9A"
            CornerRadius="15"
            MinHeight="400"
            Series="{Binding SeriesCollection}" />
    </ContentControl.Content>
</ContentControl>

    </DockPanel>
</UserControl>
